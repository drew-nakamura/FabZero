# KV260 board build for the teammate's unchanged matmul_axi (MATMUL-BOARD-001).
# Normally run through build.py, which verifies the pinned RTL hashes, runs this
# with the working directory inside OUT_DIR, then collects reports and hashes.
#
#   vivado -mode batch -source build.tcl -tclargs N LANES OUT_DIR ?STAGE? ?RTL_DIR?
#
# STAGE: "full" (default) = block design, synthesis, place and route, bitstream,
# XSA, psu_init.tcl and reports; "bd" = stop after the validated block design
# and address map (quick check, no synthesis).
# RTL_DIR: folder holding matmul.sv and matmul_axi.sv (default: rtl/ next to this
# script; build.py --handoff passes the RTL extracted from an app handoff ZIP).
# Mirrors hw/bringup/build.tcl (the verified bring-up), which is left unchanged.
if {$argc < 3 || $argc > 5} { error "Usage: build.tcl N LANES OUT_DIR ?full|bd? ?RTL_DIR?" }
lassign $argv N LANES out stage rtldir
if {$stage eq ""} { set stage full }
if {$stage ni {full bd}} { error "STAGE must be full or bd, got '$stage'" }
if {!(($N == 8 || $N == 16) && ($LANES == 1 || $LANES == 4))} {
  error "Supported: N 8|16, LANES 1|4 (got N=$N LANES=$LANES)"
}
set here [file normalize [file dirname [info script]]]
set out  [file normalize $out]
if {$rtldir eq ""} { set rtldir $here/rtl }
set rtldir [file normalize $rtldir]
foreach f {matmul.sv matmul_axi.sv} {
  if {![file exists $rtldir/$f]} { error "missing $rtldir/$f" }
}
file mkdir $out
set part      xck26-sfvc784-2LV-c
set boardpart xilinx.com:kv260_som:part0:1.4

create_project matmul_board $out/proj -part $part -force
set_property board_part $boardpart [current_project]

# ---------------------------------------------------------------- block design
create_bd_design matmul_board_bd
set ps [create_bd_cell -type ip -vlnv xilinx.com:ip:zynq_ultra_ps_e zynq_ultra_ps_e_0]
apply_bd_automation -rule xilinx.com:bd_rule:zynq_ultra_ps_e \
  -config {apply_board_preset "1"} $ps
# One AXI master (HPM0_FPD) only, so no unused master clocks dangle.
set_property -dict [list CONFIG.PSU__USE__M_AXI_GP0 {1} CONFIG.PSU__USE__M_AXI_GP1 {0} \
  CONFIG.PSU__USE__M_AXI_GP2 {0}] $ps

# SmartConnect converts the PS AXI4 master (protocol and data width) to a
# 32-bit AXI4-Lite master that leaves the block design as port M_AXI.
set sc [create_bd_cell -type ip -vlnv xilinx.com:ip:smartconnect smartconnect_0]
set_property -dict [list CONFIG.NUM_SI {1} CONFIG.NUM_MI {1}] $sc
set rst [create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset rst_pl_clk0]

set m [create_bd_intf_port -mode Master -vlnv xilinx.com:interface:aximm_rtl:1.0 M_AXI]
set_property -dict [list CONFIG.PROTOCOL {AXI4LITE} CONFIG.DATA_WIDTH {32} \
  CONFIG.ADDR_WIDTH {32} CONFIG.HAS_PROT {0}] $m
create_bd_port -dir O -type clk pl_clk0
create_bd_port -dir O -type rst pl_rst_n
set_property CONFIG.ASSOCIATED_BUSIF {M_AXI} [get_bd_ports pl_clk0]
set_property CONFIG.ASSOCIATED_RESET {pl_rst_n} [get_bd_ports pl_clk0]
set_property CONFIG.POLARITY {ACTIVE_LOW} [get_bd_ports pl_rst_n]

connect_bd_intf_net [get_bd_intf_pins $ps/M_AXI_HPM0_FPD] [get_bd_intf_pins $sc/S00_AXI]
connect_bd_intf_net [get_bd_intf_pins $sc/M00_AXI] $m
connect_bd_net [get_bd_pins $ps/pl_clk0] [get_bd_pins $ps/maxihpm0_fpd_aclk] \
  [get_bd_pins $sc/aclk] [get_bd_pins $rst/slowest_sync_clk] [get_bd_ports pl_clk0]
connect_bd_net [get_bd_pins $ps/pl_resetn0] [get_bd_pins $rst/ext_reset_in]
connect_bd_net [get_bd_pins $rst/interconnect_aresetn] [get_bd_pins $sc/aresetn]
connect_bd_net [get_bd_pins $rst/peripheral_aresetn] [get_bd_ports pl_rst_n]

# The interconnect passes the full 32-bit address (base included) to M_AXI.
# Shrink the auto-assigned window (64K) to 4K, the smallest segment, so the
# SmartConnect answers DECERR for anything beyond base+0xFFF.
assign_bd_address -target_address_space /zynq_ultra_ps_e_0/Data [get_bd_addr_segs M_AXI/Reg]
set segs [get_bd_addr_segs -of_objects [get_bd_addr_spaces zynq_ultra_ps_e_0/Data] \
  -filter {NAME =~ *M_AXI*}]
if {[llength $segs] != 1} { error "expected one M_AXI address segment, found: $segs" }
set_property RANGE 4K $segs
validate_bd_design
save_bd_design

# Record the actual assigned address and clock for the runner. Never guessed.
set base  [get_property OFFSET $segs]
set range [get_property RANGE $segs]
set clk_hz [get_property CONFIG.FREQ_HZ [get_bd_pins $ps/pl_clk0]]
set port_hz [get_property CONFIG.FREQ_HZ $m]
set fh [open $out/addresses.tcl w]
puts $fh "# Generated by build.tcl from the block design address map."
puts $fh "set MATMUL_BASE $base"
puts $fh "set MATMUL_RANGE $range"
close $fh
set fh [open $out/build_info.txt w]
puts $fh "vivado=[version -short]"
puts $fh "part=$part"
puts $fh "board_part=$boardpart"
puts $fh "board_top=matmul_board_top"
puts $fh "logical_top=matmul_axi"
puts $fh "kernel_instance=u_matmul"
puts $fh "N=$N"
puts $fh "LANES=$LANES"
puts $fh "address_segment=$segs"
puts $fh "base_address=$base"
puts $fh "address_range=$range"
puts $fh "pl_clk0_freq_hz=$clk_hz"
puts $fh "m_axi_freq_hz=$port_hz"
close $fh
puts "MATMUL_BASE=$base RANGE=$range PL_CLK0_HZ=$clk_hz M_AXI_HZ=$port_hz"

make_wrapper -files [get_files matmul_board_bd.bd] -top
add_files -norecurse [glob $out/proj/matmul_board.gen/sources_1/bd/matmul_board_bd/hdl/matmul_board_bd_wrapper.v]
add_files -norecurse [list $rtldir/matmul.sv $rtldir/matmul_axi.sv $here/matmul_board_top.sv]
puts "RTL_DIR=$rtldir"
set_property top matmul_board_top [current_fileset]
set_property generic "N=$N LANES=$LANES" [current_fileset]
update_compile_order -fileset sources_1
if {$stage eq "bd"} { puts "BD_DONE"; return }

# ---------------------------------------------------------------- full flow
launch_runs synth_1 -jobs 8
wait_on_run synth_1
if {[get_property PROGRESS [get_runs synth_1]] ne "100%"} { error "synthesis failed" }
launch_runs impl_1 -to_step write_bitstream -jobs 8
wait_on_run impl_1
if {[get_property PROGRESS [get_runs impl_1]] ne "100%"} { error "implementation/bitstream failed" }

open_run impl_1
set rpt $out/reports
file mkdir $rpt
report_clocks -file $rpt/clocks.rpt
check_timing -verbose -file $rpt/check_timing.rpt
report_route_status -file $rpt/route_status.rpt
report_pulse_width -file $rpt/pulse_width.rpt
# Parameters actually elaborated into the kernel (proves the generic reached it).
set k [get_cells u_matmul]
set fh [open $out/build_info.txt a]
foreach p {N LANES} {
  if {[catch {get_property $p $k} v] || $v eq ""} { set v unknown }
  puts $fh "elaborated_$p=$v"
}
foreach s {WNS TNS WHS THS TPWS} {
  puts $fh "impl_$s=[get_property STATS.$s [get_runs impl_1]]"
}
puts $fh "built_at=[clock format [clock seconds] -format {%Y-%m-%dT%H:%M:%S%z}]"
close $fh

set tag n${N}_l${LANES}
file copy -force [glob $out/proj/matmul_board.runs/impl_1/matmul_board_top.bit] $out/matmul_board_$tag.bit
file copy -force [glob $out/proj/matmul_board.gen/sources_1/bd/matmul_board_bd/ip/*zynq_ultra_ps_e_0*/psu_init.tcl] $out/psu_init.tcl
write_hw_platform -fixed -include_bit -force $out/matmul_board_$tag.xsa
write_bd_tcl -force $out/matmul_board_bd_export.tcl
puts "WNS=[get_property STATS.WNS [get_runs impl_1]] WHS=[get_property STATS.WHS [get_runs impl_1]] TPWS=[get_property STATS.TPWS [get_runs impl_1]]"
puts "BUILD_DONE"
